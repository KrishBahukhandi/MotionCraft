{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    // A referenced project must emit (TS6310), so send the output somewhere
    // harmless. Emitting beside the source produced a vite.config.js, and Vite
    // resolves .js before .ts — the build then silently loaded a downleveled
    // config whose `__dirname` is undefined under "type": "module".
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
